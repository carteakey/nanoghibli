# ==============================================================================
# NanoGhibli Environment Configuration
# ==============================================================================

# Option A: Google Cloud Vertex AI / Gemini Enterprise Agent Platform
# (RECOMMENDED for Google Cloud $300 Free Trial credits - e.g., theherdingdog@gmail.com)
#
# Vertex AI routes requests to Google Cloud (https://aiplatform.googleapis.com)
# so your $300 credit is consumed rather than hitting AI Studio limits.
#
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Authentication for Google Cloud:
# 1. Run in terminal: gcloud auth application-default login
#    OR
# 2. Provide a service account JSON file path:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ------------------------------------------------------------------------------
# Option B: Google AI Studio (Gemini Developer API)
# (Use if you have a direct Gemini API key from https://aistudio.google.com)
#
# GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Optional: OpenAI API Key (only if using gpt-image-1.5 in stylizer rotation)
# OPENAI_API_KEY=your_openai_api_key_here
